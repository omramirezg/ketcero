---
// La página de una lección: qué vas a aprender, antes de empezar, cuánto dura y el botón para abrir la animación.
import Base from "../../../layouts/Base.astro";
import Clip from "../../../components/Clip.astro";
import AntesDeEsta from "../../../components/AntesDeEsta.astro";
import { AUTOR, DOMINIO, cursos, ld, type Curso, type Leccion } from "../../../lib/sitio";

export async function getStaticPaths() {
  return (await cursos()).flatMap((c) => c.publicadas.map((l, n) => ({
    params: { curso: c.slug, leccion: l.slug },
    props: { c, l, ant: c.publicadas[n - 1] ?? null, sig: c.publicadas[n + 1] ?? null },
  })));
}
const { c, l, ant, sig } = Astro.props as { c: Curso; l: Leccion; ant: Leccion | null; sig: Leccion | null };
const tema = c.temasNum.find((t) => t.clave === l.tema)!;
const cabeza = ld({ "@context": "https://schema.org", "@type": "LearningResource", name: l.titulo, description: l.descripcion,
  url: DOMINIO + l.pagina, inLanguage: "es", learningResourceType: "Animación interactiva", educationalLevel: "Universitario",
  timeRequired: `PT${l.minutos}M`, teaches: l.aprender, image: DOMINIO + l.miniaturaUrl,
  author: { "@type": "Person", name: AUTOR, url: `${DOMINIO}/omar/` },
  isPartOf: { "@type": "Course", name: c.nombre, url: `${DOMINIO}/cursos/${c.slug}/` } });
---
<Base titulo={`${l.titulo} · Ket Cero`} descripcion={l.descripcion} ruta={l.pagina} actual={l.pagina} cabeza={cabeza}>
<div class="cuerpo solo leccion">
<main id="contenido">
<section class="cabeza">
<div class="mono"><a href="/cursos/">Cursos</a> / <a href={`/cursos/${c.slug}/`}>{c.nombre}</a> / <a href={`/cursos/${c.slug}/#${l.tema}`}>{tema.titulo}</a> · lección {l.numero}</div>
<h1>{l.titulo}</h1>
<p>{l.descripcion}</p>
<div class="acciones"><a class="boton" href={l.url} data-abre-animacion>Abrir la animación →</a>
<a id="seguir" class="ir" hidden data-leccion={l.slug} data-animacion={l.url} data-abre-animacion href={l.url}></a></div>
<p class="aviso">Versión preliminar: todavía está en revisión y puede tener errores.</p>
</section>
<a class="figura" href={l.url} data-abre-animacion aria-label={`Abrir la animación: ${l.titulo}`}><Clip leccion={l} carga="eager" /></a>
<section class="ficha">
<h2>Qué vas a aprender</h2>
<ul>{l.aprender.map((p) => <li>{p}</li>)}</ul>
<h2>Antes de empezar</h2>
<p>{l.requisitos}</p>
<AntesDeEsta leccion={l} />
<h2>Cuánto dura</h2>
<p>{l.datos}. A tu ritmo, unos {l.minutos} minutos. Avanza con las flechas del teclado o con los botones de abajo; Ctrl + rueda del mouse acerca el dibujo.</p>
</section>
<nav class="vecinas" aria-label="Lecciones">{ant ? <a href={ant.pagina}>← {ant.titulo}</a> : <span></span>}{sig ? <a href={sig.pagina}>{sig.titulo} →</a> : <span></span>}</nav>
</main>
</div>
</Base>
